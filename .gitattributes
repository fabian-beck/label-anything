# Auto detect text files; LF in the working tree on every platform (tests compare
# generated fixtures byte for byte)
* text=auto eol=lf
*.ttf binary
*.png binary
*.jpg binary
*.webp binary
# Generated files: collapse in diffs
rust/crates/la-core/src/generated/** linguist-generated=true
ts/packages/*/src/generated/** linguist-generated=true
