{
  "kind": "expr",
  "name": "comparison",
  "description": "== and != (structural equality), < <= > >= (numbers numerically, strings by code points, anything else false), in / not in.",
  "context": {
    "attrs": {
      "o": { "a": 1, "b": [1, { "c": null }] },
      "p": { "b": [1, { "c": null }], "a": 1 },
      "q": { "a": 1 },
      "l": [1, "x"],
      "category": "util",
      "n": 10,
      "z": -0.0
    }
  },
  "cases": [
    { "expr": "1 == 1", "value": true },
    { "expr": "1 == 2", "value": false },
    { "expr": "1 != 2", "value": true },
    { "expr": "1 != 1", "value": false },
    { "expr": "1 == 1.0", "value": true },
    { "expr": "0 == -0", "value": true },
    { "expr": "attrs.z == 0", "value": true },
    { "expr": "0.1 + 0.2 == 0.3", "value": false },
    { "expr": "'a' == 'a'", "value": true },
    { "expr": "'a' == 'A'", "value": false },
    { "expr": "'é' == '\\u00e9'", "value": true },
    { "expr": "'1' == 1", "value": false, "note": "different types are unequal" },
    { "expr": "'1' != 1", "value": true },
    { "expr": "true == 1", "value": false },
    { "expr": "false == 0", "value": false },
    { "expr": "true == true", "value": true },
    { "expr": "null == null", "value": true },
    { "expr": "null == false", "value": false },
    { "expr": "null == 0", "value": false },
    { "expr": "null == ''", "value": false },
    { "expr": "attrs.missing == null", "value": true },
    { "expr": "[] == []", "value": true },
    { "expr": "[1, 2] == [1, 2]", "value": true },
    { "expr": "[1, 2] == [2, 1]", "value": false },
    { "expr": "[1, 2] == [1, 2, 3]", "value": false },
    { "expr": "[1, [2, 3]] == [1, [2, 3]]", "value": true },
    { "expr": "[0] == [-0]", "value": true },
    { "expr": "[1] == 1", "value": false },
    { "expr": "attrs.l == [1, 'x']", "value": true },
    { "expr": "attrs.o == attrs.p", "value": true, "note": "objects: same keys, equal values, order irrelevant" },
    { "expr": "attrs.o == attrs.q", "value": false },
    { "expr": "attrs.o != attrs.q", "value": true },
    { "expr": "attrs.o.b == [1, attrs.p.b[1]]", "value": true },
    { "expr": "attrs.o == [1]", "value": false },
    { "expr": "1 < 2", "value": true },
    { "expr": "2 < 1", "value": false },
    { "expr": "1 <= 1", "value": true },
    { "expr": "1 >= 2", "value": false },
    { "expr": "2 > 1", "value": true },
    { "expr": "2 >= 2", "value": true },
    { "expr": "-0 < 0", "value": false },
    { "expr": "-0 <= 0", "value": true },
    { "expr": "-1e308 < 1e308", "value": true },
    { "expr": "attrs.n >= 10", "value": true },
    { "expr": "'a' < 'b'", "value": true },
    { "expr": "'a' < 'B'", "value": false, "note": "code point order: 'B' (66) < 'a' (97)" },
    { "expr": "'Z' < 'a'", "value": true },
    { "expr": "'abc' < 'abd'", "value": true },
    { "expr": "'ab' < 'abc'", "value": true },
    { "expr": "'abc' > 'ab'", "value": true },
    { "expr": "'' < 'a'", "value": true },
    { "expr": "'a' <= 'a'", "value": true },
    { "expr": "'a' >= 'a'", "value": true },
    { "expr": "'é' > 'z'", "value": true },
    { "expr": "'\\uFFFF' < '😀'", "value": true, "note": "code points, not UTF-16 units (U+FFFF < U+1F600)" },
    { "expr": "'\\uE000' < '😀'", "value": true, "note": "UTF-16 order would say false (0xE000 > 0xD83D)" },
    { "expr": "'😀' > '\\uFFFF'", "value": true },
    { "expr": "'😀' >= '\\uFFFF'", "value": true },
    { "expr": "'\\uFFFF' <= '😀'", "value": true },
    { "expr": "'𐀀' < '😀'", "value": true },
    { "expr": "'a😀' < 'a\\uFFFF'", "value": false },
    { "expr": "1 < 'a'", "value": false, "note": "mixed types: ordering comparisons are false" },
    { "expr": "'a' < 1", "value": false },
    { "expr": "'1' < 2", "value": false },
    { "expr": "null < 1", "value": false },
    { "expr": "null <= null", "value": false },
    { "expr": "true < 2", "value": false },
    { "expr": "false < true", "value": false, "note": "booleans are not ordered" },
    { "expr": "true >= false", "value": false },
    { "expr": "[1] < [2]", "value": false },
    { "expr": "attrs.o > attrs.q", "value": false },
    { "expr": "1 in [1, 2, 3]", "value": true },
    { "expr": "4 in [1, 2, 3]", "value": false },
    { "expr": "4 not in [1, 2, 3]", "value": true },
    { "expr": "1 not in [1, 2, 3]", "value": false },
    { "expr": "'b' in ['a', 'b']", "value": true },
    { "expr": "1 in []", "value": false },
    { "expr": "1 not in []", "value": true },
    { "expr": "null in [null]", "value": true },
    { "expr": "0 in [-0]", "value": true },
    { "expr": "'1' in [1]", "value": false },
    { "expr": "[1] in [[1], 2]", "value": true },
    { "expr": "attrs.category in ['core', 'util']", "value": true },
    { "expr": "attrs.category not in ['core', 'util']", "value": false },
    { "expr": "attrs.missing in [null]", "value": true },
    { "expr": "attrs.n in [5 + 5]", "value": true },
    { "expr": "1 + 1 in [2]", "value": true, "note": "+ binds tighter than in" },
    { "expr": "!1 in [1]", "value": false, "note": "! binds looser than in: !(1 in [1])" },
    { "expr": "(1 in [1]) == true", "value": true },
    { "expr": "(1 < 2) == true", "value": true },
    { "expr": "1 == 1 && 2 != 3", "value": true }
  ]
}
