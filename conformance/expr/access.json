{
  "kind": "expr",
  "name": "access",
  "description": "Variables, member and index access on objects, lists and other values, method syntax.",
  "context": {
    "attrs": {
      "name": "org.example.Foo",
      "cbo": 41,
      "category": "core",
      "tags": ["a", "b", "c"],
      "nested": { "x": { "y": 3 } },
      "list": [10, 20, 30],
      "mixed": [1, "two", [3], { "four": 4 }],
      "empty": {},
      "nul": null,
      "z": 0,
      "s p a c e": 1,
      "in": "kw",
      "unicodé": "u",
      "": "empty key",
      "__proto__": 5,
      "constructor": 6,
      "toString": 7
    },
    "id": "item-1",
    "index": 3,
    "text": "Hello",
    "priority": 2.5,
    "tier": 1,
    "x": 10.5,
    "y": -20
  },
  "cases": [
    { "expr": "attrs.name", "value": "org.example.Foo" },
    { "expr": "attrs.cbo", "value": 41 },
    { "expr": "attrs['cbo']", "value": 41 },
    { "expr": "attrs[\"s p a c e\"]", "value": 1 },
    { "expr": "attrs['']", "value": "empty key" },
    { "expr": "attrs['in']", "value": "kw", "note": "keywords cannot follow '.', use [...]" },
    { "expr": "attrs['unicodé']", "value": "u" },
    { "expr": "attrs.missing", "value": null },
    { "expr": "attrs.nul", "value": null },
    { "expr": "attrs.nested.x.y", "value": 3 },
    { "expr": "attrs.nested['x']['y']", "value": 3 },
    { "expr": "attrs['nested'].x", "value": { "y": 3 } },
    { "expr": "attrs.nested.x.missing", "value": null },
    { "expr": "attrs.missing.x", "value": null, "note": "member access on null is null" },
    { "expr": "attrs.missing.x.y[0].z", "value": null },
    { "expr": "attrs.cbo.x", "value": null },
    { "expr": "attrs.name.length", "value": null, "note": "strings and lists have no members" },
    { "expr": "attrs.tags.length", "value": null },
    { "expr": "attrs.tags.map", "value": null },
    { "expr": "attrs.empty", "value": {} },
    { "expr": "attrs.empty.x", "value": null },
    { "expr": "attrs.__proto__", "value": 5, "note": "only own keys of the JSON object exist" },
    { "expr": "attrs.constructor", "value": 6 },
    { "expr": "attrs.toString", "value": 7 },
    { "expr": "attrs.hasOwnProperty", "value": null },
    { "expr": "attrs.valueOf", "value": null },
    { "expr": "attrs.empty.constructor", "value": null },
    { "expr": "attrs.empty['__proto__']", "value": null },
    { "expr": "attrs.tags[0]", "value": "a" },
    { "expr": "attrs.tags[2]", "value": "c" },
    { "expr": "attrs.tags[3]", "value": null, "note": "out of range" },
    { "expr": "attrs.tags[-1]", "value": null },
    { "expr": "attrs.tags[1.5]", "value": null, "note": "non-integer index" },
    { "expr": "attrs.tags[0.0]", "value": "a" },
    { "expr": "attrs.tags[-0]", "value": "a" },
    { "expr": "attrs.tags[1e300]", "value": null },
    { "expr": "attrs.tags['0']", "value": null, "note": "string index on a list" },
    { "expr": "attrs.tags[true]", "value": null },
    { "expr": "attrs.tags[null]", "value": null },
    { "expr": "attrs.tags[1 + 1]", "value": "c" },
    { "expr": "attrs.list[attrs.z]", "value": 10 },
    { "expr": "attrs.list[len(attrs.tags) - 1]", "value": 30 },
    { "expr": "attrs.mixed[3].four", "value": 4 },
    { "expr": "attrs.mixed[2][0]", "value": 3 },
    { "expr": "attrs.mixed[1]", "value": "two" },
    { "expr": "attrs[1]", "value": null, "note": "number index on an object" },
    { "expr": "attrs[null]", "value": null },
    { "expr": "attrs[attrs.category]", "value": null },
    { "expr": "attrs['na' + 'me']", "value": "org.example.Foo" },
    { "expr": "'abc'[0]", "value": null, "note": "strings cannot be indexed" },
    { "expr": "[1, 2, 3][1]", "value": 2 },
    { "expr": "[1, 2, 3][3]", "value": null },
    { "expr": "[[1, 2], [3]][1][0]", "value": 3 },
    { "expr": "null.x", "value": null },
    { "expr": "null[0]", "value": null },
    { "expr": "true.x", "value": null },
    { "expr": "1.e5", "value": null, "note": "the number 1, then member e5" },
    { "expr": "1.5.x", "value": null },
    { "expr": "id", "value": "item-1" },
    { "expr": "index", "value": 3 },
    { "expr": "text", "value": "Hello" },
    { "expr": "priority", "value": 2.5 },
    { "expr": "tier", "value": 1 },
    { "expr": "x", "value": 10.5 },
    { "expr": "y", "value": -20 },
    { "expr": "x + y * index", "value": -49.5 },
    { "expr": "id + ':' + text", "value": "item-1:Hello" },
    { "expr": "priority", "context": { "priority": null }, "value": null },
    { "expr": "tier", "context": { "tier": null }, "value": null },
    { "expr": "[id, index, text, priority, tier, x, y]", "context": { "attrs": {}, "id": "", "index": 0, "text": "", "priority": null, "tier": null, "x": 0, "y": 0 }, "value": ["", 0, "", null, null, 0, 0] },
    { "expr": "attrs", "context": { "attrs": { "a": [1, { "b": null }] } }, "value": { "a": [1, { "b": null }] } },
    { "expr": "attrs.a", "context": { "attrs": null }, "value": null, "note": "attrs may be any JSON value" },
    { "expr": "attrs[0]", "context": { "attrs": [7] }, "value": 7 },
    { "expr": "attrs.name.startsWith('org.')", "value": true },
    { "expr": "attrs.name.endsWith('Foo')", "value": true },
    { "expr": "attrs.name.contains('example')", "value": true },
    { "expr": "attrs.tags.contains('b')", "value": true },
    { "expr": "attrs.tags.len()", "value": 3 },
    { "expr": "attrs.name.len()", "value": 15 },
    { "expr": "text.len()", "value": 5 },
    { "expr": "attrs.name.lower()", "value": "org.example.foo" },
    { "expr": "attrs.name.upper().lower()", "value": "org.example.foo" },
    { "expr": "attrs.cbo.abs()", "value": 41 },
    { "expr": "(-3).abs()", "value": 3 },
    { "expr": "-3.abs()", "value": -3, "note": "unary minus applies after the method call" },
    { "expr": "2.5.floor()", "value": 2 },
    { "expr": "1.floor()", "value": 1 },
    { "expr": "attrs.cbo.min(10)", "value": 10 },
    { "expr": "attrs.cbo.max(10, 50)", "value": 50 },
    { "expr": "attrs.missing.coalesce('d')", "value": "d" },
    { "expr": "'5'.number() + 1", "value": 6 },
    { "expr": "attrs.tags[0].upper()", "value": "A" },
    { "expr": "attrs.missing.len()", "value": null },
    { "expr": "attrs.list.len().max(attrs.cbo)", "value": 41 },
    { "expr": "attrs.nested.x.y.abs", "value": null, "note": "without parentheses abs is a member" }
  ]
}
