{
  "kind": "expr",
  "name": "logic",
  "description": "Truthiness, ! && || (boolean results, short-circuit), precedence of ! below comparison.",
  "context": { "attrs": { "flag": true, "off": false, "n": 5, "empty": {}, "list": [], "zero": 0, "s": "" } },
  "cases": [
    { "expr": "!true", "value": false },
    { "expr": "!false", "value": true },
    { "expr": "!null", "value": true },
    { "expr": "!0", "value": true },
    { "expr": "!-0", "value": true },
    { "expr": "!1", "value": false },
    { "expr": "!-1", "value": false },
    { "expr": "!''", "value": true },
    { "expr": "!'a'", "value": false },
    { "expr": "!'0'", "value": false, "note": "a non-empty string is truthy" },
    { "expr": "![]", "value": true },
    { "expr": "![0]", "value": false },
    { "expr": "![[]]", "value": false },
    { "expr": "!attrs.empty", "value": false, "note": "every object is truthy, even {}" },
    { "expr": "!attrs", "value": false },
    { "expr": "!attrs.list", "value": true },
    { "expr": "!attrs.missing", "value": true },
    { "expr": "!!1", "value": true },
    { "expr": "!!''", "value": false },
    { "expr": "!!!0", "value": true },
    { "expr": "true && true", "value": true },
    { "expr": "true && false", "value": false },
    { "expr": "false && true", "value": false },
    { "expr": "false && false", "value": false },
    { "expr": "true || false", "value": true },
    { "expr": "false || false", "value": false },
    { "expr": "1 && 'a'", "value": true, "note": "&& and || return booleans, not operands" },
    { "expr": "'a' && 0", "value": false },
    { "expr": "0 || ''", "value": false },
    { "expr": "null || 'x'", "value": true },
    { "expr": "'x' || null", "value": true },
    { "expr": "[] || [0]", "value": true },
    { "expr": "attrs.empty && true", "value": true },
    { "expr": "false || false || true", "value": true },
    { "expr": "true && true && false", "value": false },
    { "expr": "true && true && true && true", "value": true },
    { "expr": "true || false && false", "value": true, "note": "&& binds tighter than ||" },
    { "expr": "(true || false) && false", "value": false },
    { "expr": "false && false || true", "value": true },
    { "expr": "false && (false || true)", "value": false },
    { "expr": "false && attrs.x.y.z", "value": false, "note": "short-circuit" },
    { "expr": "true || 1 / 0", "value": true, "note": "short-circuit" },
    { "expr": "false || 1 / 0", "value": false, "note": "1 / 0 is null, which is falsy" },
    { "expr": "true && 1 / 0", "value": false },
    { "expr": "attrs.missing && attrs.missing.x", "value": false },
    { "expr": "!1 == 2", "value": true, "note": "! applies to the comparison: !(1 == 2)" },
    { "expr": "!(1 == 2)", "value": true },
    { "expr": "(!1) == 2", "value": false },
    { "expr": "!attrs.n > 3", "value": false, "note": "!(attrs.n > 3)" },
    { "expr": "!0 && 1", "value": true },
    { "expr": "!(0 && 1)", "value": true },
    { "expr": "!attrs.flag", "value": false },
    { "expr": "attrs.flag && attrs.n > 3", "value": true },
    { "expr": "attrs.off || attrs.n < 3", "value": false },
    { "expr": "attrs.zero || attrs.s || attrs.list || attrs.missing", "value": false },
    { "expr": "attrs.zero || attrs.empty", "value": true },
    { "expr": "attrs", "context": { "attrs": {} }, "value": {}, "truthy": true, "term": null },
    { "expr": "attrs.list", "value": [], "truthy": false, "term": null },
    { "expr": "attrs.flag", "value": true, "truthy": true, "term": 1 },
    { "expr": "attrs.off", "value": false, "truthy": false, "term": 0 },
    { "expr": "attrs.n", "value": 5, "truthy": true, "term": 5 },
    { "expr": "attrs.s", "value": "", "truthy": false, "term": null }
  ]
}
