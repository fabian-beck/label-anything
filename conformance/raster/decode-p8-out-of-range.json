{
  "kind": "raster",
  "name": "decode: 8-bit palette, indices beyond PLTE (opaque black), short tRNS",
  "image": {
    "file": "images/p8-out-of-range.png"
  },
  "decode": {
    "width": 12,
    "height": 6,
    "rgba_fnv1a32": "a1b3c3d1"
  },
  "background": [
    0,
    0,
    0
  ],
  "runs": [
    {
      "name": "ink, cell 1",
      "mode": {
        "kind": "ink",
        "background": null,
        "threshold": 0.12,
        "dilate": 0
      },
      "class": "ink",
      "placement": {
        "scale": 1,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 1,
        "cols": 8,
        "rows": 8
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "a28e440d",
          "sum": 7650,
          "nonzero": 30,
          "coverage": "//////8AAAD///8AAAD///8AAAD/////AAD//////wD//////wAAAP///wAAAP//AAAAAAAAAAAAAAAAAAAAAA=="
        }
      ]
    },
    {
      "name": "cost, scale 2, cell 1",
      "mode": {
        "kind": "cost",
        "invert": false
      },
      "class": "cost",
      "placement": {
        "scale": 2,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 1,
        "cols": 6,
        "rows": 6
      },
      "expect": [
        {
          "class": "cost",
          "fnv1a32": "3b91eca8",
          "sum": 2951,
          "nonzero": 18,
          "coverage": "Zqnppmap6aZmqemmZqnppmapAAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ]
    },
    {
      "name": "alpha 0.5, cell 2",
      "mode": {
        "kind": "alpha",
        "threshold": 0.5
      },
      "class": "ink",
      "placement": {
        "scale": 1,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 2,
        "cols": 6,
        "rows": 6
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "753b5acb",
          "sum": 3950,
          "nonzero": 18,
          "coverage": "v7///7+///+/v///v7///7+/AAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ]
    }
  ]
}
