{
  "kind": "raster",
  "name": "ink: anti-aliased strokes; scales 1, 2, 0.5, 3; offsets; dilation 0-2; non-integer cells",
  "image": {
    "file": "images/strokes-rgb8.png"
  },
  "decode": {
    "width": 64,
    "height": 40,
    "rgba_fnv1a32": "ff20c8f8"
  },
  "background": [
    255,
    255,
    255
  ],
  "runs": [
    {
      "name": "defaults (auto background, threshold 0.12, dilate 1), cell 2",
      "mode": {
        "kind": "ink",
        "background": null,
        "threshold": 0.12,
        "dilate": 1
      },
      "class": "ink",
      "placement": {
        "scale": 1,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 2,
        "cols": 32,
        "rows": 20
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "1911bd06",
          "sum": 84215,
          "nonzero": 372,
          "coverage": ""
        }
      ]
    },
    {
      "name": "dilate 0, cell 1.5, grid larger than the raster",
      "mode": {
        "kind": "ink",
        "background": null,
        "threshold": 0.12,
        "dilate": 0
      },
      "class": "ink",
      "placement": {
        "scale": 1,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 1.5,
        "cols": 43,
        "rows": 27
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "88769452",
          "sum": 66189,
          "nonzero": 346,
          "coverage": ""
        }
      ]
    },
    {
      "name": "HiDPI scale 2, explicit background, threshold 0.3, dilate 2, fractional offset",
      "mode": {
        "kind": "ink",
        "background": "#fafaf8",
        "threshold": 0.3,
        "dilate": 2
      },
      "class": "ink",
      "placement": {
        "scale": 2,
        "offset": [
          3.25,
          -1.5
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 1,
        "cols": 40,
        "rows": 22
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "830d2bf6",
          "sum": 99413,
          "nonzero": 476,
          "coverage": ""
        }
      ]
    },
    {
      "name": "scale 0.5 (pixels larger than cells), negative offset, cell 3",
      "mode": {
        "kind": "ink",
        "background": null,
        "threshold": 0.12,
        "dilate": 1
      },
      "class": "ink",
      "placement": {
        "scale": 0.5,
        "offset": [
          -7,
          5
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 3,
        "cols": 40,
        "rows": 30
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "00ead3c9",
          "sum": 131872,
          "nonzero": 594,
          "coverage": ""
        }
      ]
    },
    {
      "name": "scale 3, cell 0.75, grid origin (-1, -1)",
      "mode": {
        "kind": "ink",
        "background": null,
        "threshold": 0.05,
        "dilate": 0
      },
      "class": "ink",
      "placement": {
        "scale": 3,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          -1,
          -1
        ],
        "cell": 0.75,
        "cols": 40,
        "rows": 30
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "91a8da0a",
          "sum": 40995,
          "nonzero": 245,
          "coverage": ""
        }
      ]
    },
    {
      "name": "alpha on an opaque image",
      "mode": {
        "kind": "alpha",
        "threshold": 0.1
      },
      "class": "ink",
      "placement": {
        "scale": 1,
        "offset": [
          0,
          0
        ]
      },
      "grid": {
        "origin": [
          0,
          0
        ],
        "cell": 2,
        "cols": 32,
        "rows": 20
      },
      "expect": [
        {
          "class": "ink",
          "fnv1a32": "b18e0d45",
          "sum": 163200,
          "nonzero": 640,
          "coverage": ""
        }
      ]
    }
  ]
}
