{
  "kind": "svg",
  "name": "nested svg viewports",
  "description": "A nested <svg> establishes a viewport (x, y, width, height; default 100%) with its own viewBox; percentages inside refer to the nearest viewBox; stroke widths scale with it.",
  "svg": [
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"200\">",
    "  <svg x=\"50\" y=\"50\" width=\"100\" height=\"100\" viewBox=\"0 0 10 10\">",
    "    <rect id=\"inner\" width=\"10\" height=\"10\" fill=\"none\" stroke=\"black\" stroke-width=\"0.1\"/>",
    "    <rect id=\"half\" width=\"50%\" height=\"50%\"/>",
    "  </svg>",
    "  <svg x=\"10\" y=\"160\" width=\"50%\" height=\"20\"><rect id=\"pct\" width=\"100%\" height=\"100%\"/></svg>",
    "  <svg width=\"0\" height=\"10\"><rect id=\"hidden\" width=\"5\" height=\"5\"/></svg>",
    "</svg>"
  ],
