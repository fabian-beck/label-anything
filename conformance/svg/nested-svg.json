        ],
        "bbox": [
          50,
          50,
          100,
          100
        ]
      },
      {
        "id": "half",
        "fill_area": 2500,
        "bbox": [
          50,
          50,
          50,
          50
        ]
      },
      {
        "id": "pct",
        "fill_area": 2000,
        "bbox": [
          10,
          160,
          100,
          20
        ]
      },
      {
        "id": "hidden",
        "count": 0
      }
    ],
    "elements": {
