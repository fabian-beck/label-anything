{
  "kind": "svg",
  "name": "selector semantics",
  "description": "First matching rule wins; :background (bbox ≥ 90 % of the canvas both ways, boundary inclusive), :small (≤ 16 px both ways, boundary inclusive; text height 16 px counts), :unfilled, compound selectors with attributes, quoted attribute values, child combinator, escaped id; unmatched primitives use default_class (here 'ignore').",
  "tolerance": 0.02,
  "default_class": "ignore",
  "classes": [
    {
      "selector": ":background",
      "class": "ignore"
    },
    {
      "selector": "circle.outlier[data-k=1]",
      "class": "outlier1"
    },
    {
      "selector": "g[data-role='series'] > circle",
      "class": "series"
    },
    {
      "selector": "rect:unfilled",
      "class": "outline"
    },
    {
      "selector": ":small",
      "class": "small"
    },
    {
      "selector": "#a\\.b path",
      "class": "escaped"
    },
    {
      "selector": "circle",
      "class": "round"
    },
    {
      "selector": "svg > g.missing, use",
      "class": "never"
    }
  ],
  "svg": [
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\">",
    "  <rect id=\"bg\" width=\"100\" height=\"100\" fill=\"white\"/>",
    "  <rect id=\"bg90\" x=\"5\" y=\"5\" width=\"90\" height=\"90\" fill=\"#eee\"/>",
    "  <rect id=\"nb\" x=\"0\" y=\"0\" width=\"89\" height=\"95\" fill=\"none\" stroke=\"black\"/>",
    "  <circle id=\"s16\" cx=\"20\" cy=\"20\" r=\"8\"/>",
    "  <circle id=\"s17\" cx=\"50\" cy=\"20\" r=\"8.5\"/>",
    "  <g class=\"grp\" data-role=\"series\"><circle id=\"o1\" class=\"outlier\" data-k=\"1\" cx=\"20\" cy=\"60\" r=\"10\"/><circle id=\"o2\" class=\"outlier\" data-k=\"2\" cx=\"50\" cy=\"60\" r=\"10\"/></g>",
    "  <g id=\"a.b\"><path d=\"M 70 70 h 20 v 20 h -20 z\"/></g>",
    "  <text id=\"t\" x=\"60\" y=\"95\">t</text>",
    "  <g class=\"other\"><rect id=\"lone\" x=\"70\" y=\"10\" width=\"20\" height=\"20\"/></g>",
    "</svg>"
  ],
  "expect": {
    "classes": {
      "outline": {
        "count": 1,
        "polylines": 1,
        "stroke_length": 368
      },
      "small": {
        "count": 2,
        "polygons": 1,
        "rects": 1
      },
      "round": {
        "count": 1,
        "polygons": 1,
        "fill_area": 226.980069
      },
      "outlier1": {
        "count": 1,
        "fill_area": 314.159265
      },
      "series": {
        "count": 1,
        "fill_area": 314.159265
      },
      "escaped": {
        "count": 1,
        "fill_area": 400
      }
    },
    "elements": {
      "s16": {
        "bbox": [
          12,
          12,
          16,
          16
        ]
      },
      "t": {
        "bbox": [
          60,
          82.2,
          8.8,
          16
        ]
      }
    }
  }
}
