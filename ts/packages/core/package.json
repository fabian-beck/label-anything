{
  "name": "@label-anything/core",
  "version": "0.1.0",
  "description": "Label Anything: label placement engine for charts, maps and diagrams (pure TypeScript, zero native/WASM dependencies).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!dist/conformance", "!src/conformance"],
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/fabian-beck/label-anything", "directory": "ts/packages/core" },
  "homepage": "https://fabian-beck.github.io/label-anything/",
  "bugs": "https://github.com/fabian-beck/label-anything/issues",
  "publishConfig": { "access": "public" },
  "keywords": ["label placement", "labeling", "visualization", "leader lines"],
  "scripts": { "build": "tsc -b", "test": "vitest run --root ../../.. ts/packages/core", "prepack": "tsc -b" },
  "dependencies": { "@label-anything/text": "0.1.0", "@label-anything/svg": "0.1.0", "@label-anything/raster": "0.1.0" }
}
