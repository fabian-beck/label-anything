{
  "$comment": "Preset 'graph': node-link diagrams. Edges are 'lines'.",
  "description": "Node-link diagrams: internal labels for large nodes, octilinear leaders, edges are soft obstacles.",
  "options": {
    "placement": { "models": ["internal", "adjacent", "slider", "distant"], "internal": "auto", "position_order": "perceptual" },
    "avoid": {
      "label": { "lines": 1.0, "ink": 0.5 },
      "leader": { "lines": 0.5 }
    },
    "leaders": { "style": "angles", "angles": [0, 45, 90, 135, 180, 225, 270, 315] }
  },
  "svg_classes": [
    { "selector": ":background", "class": "ignore" },
    { "selector": "text", "class": "text" },
    { "selector": "line, polyline, path", "class": "lines" },
    { "selector": "*", "class": "ink" }
  ]
}
